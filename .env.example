# ── Copy to your Railway project variables (the onboarding session sets these for you) ──

# Discord (your own bot — create at discord.com/developers/applications)
DISCORD_TOKEN=
MARK_DISCORD_ID=            # your own Discord user ID (the bot only talks to you)

# Anthropic (your key, ideally under the shared Console org)
ANTHROPIC_API_KEY=

# Groq (shared key from Mark — enables voice transcription)
GROQ_API_KEY=

# Google (shared OAuth app from Mark — you authorize your OWN account via /auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN is created when you visit /auth — stored in the volume, not here

# Asana (optional — your token + your main task project)
ASANA_TOKEN=
ASANA_PROJECT_GID=         # the project the agent manages (number in the project URL)

# Calendar (optional — extra shared calendars beyond your primary, comma-separated IDs)
EXTRA_CALENDAR_IDS=

# WhatsApp (OPT-IN, off by default). Unofficial connection (Baileys) — can risk a
# WhatsApp ban on your personal number. Only set this if you understand that.
ENABLE_WHATSAPP=

# Web auth secret for the /auth link (pick any random word)
AUTH_SECRET=

# Storage (Railway persistent volume)
DB_PATH=/data/mark-agent.db
